# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Every variable here has a working default in docker-compose.yml, so
# `docker compose up --build` succeeds on a clean clone with no .env at all.
# Create one when you want the LLM paths, or to override anything below.

# --- Anthropic (optional) ---
# Without a key, NL->SQL returns a default HR leaderboard and the classic
# agent falls back to rule-based parsing. Every structured /api/* endpoint
# works fully without a key.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Postgres (inside the docker compose network) ---
# Matches the credentials provisioned in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://user:password@db:5432/baseball_db

# --- Read-only role for the NL->SQL path ---
# LLM-generated SQL executes as this SELECT-only role (statement_timeout=5s,
# read-only transactions). Provisioned automatically by
# db/init/01-readonly-role.sh (fresh volumes) and at backend startup.
# Change the password for any deployment that is not local-only.
NL2SQL_RO_USER=nl2sql_ro
NL2SQL_RO_PASSWORD=nl2sql_ro
# READONLY_DATABASE_URL=  # full override if the role lives elsewhere

# --- CORS ---
# Comma-separated allowed origins. Unset means "*" with credentials disabled,
# which is fine locally — set it explicitly before deploying.
# CORS_ALLOW_ORIGINS=https://your-frontend.example.com

# --- Host-side data loaders ---
# The loaders (data_pipeline/scripts/*.py) and the ingestion pipeline
# (data_pipeline/ingest/) run on your host, outside docker, so they need
# localhost instead of the compose hostname `db`:
#   DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/baseball_db
# Export that value in the shell where you run them. On macOS, a local
# Postgres listening on loopback will shadow the compose port mapping —
# see "First-run notes" in README.md.

# --- Frontend (optional, outside docker) ---
# REACT_APP_API_URL=http://localhost:8000
